# Configuration read by docker compose, the backend and the frontend.
# Copy it to .env to change a value: cp .env.example .env (without .env, the same defaults are used).
DB_PORT=5432
EMBEDDINGS_PORT=8080
BACKEND_PORT=8000
FRONTEND_PORT=5173

DATABASE_URL=postgresql://pokedex:pokedex@localhost:${DB_PORT}/pokedex
EMBEDDINGS_URL=http://localhost:${EMBEDDINGS_PORT}
VITE_API_URL=http://localhost:${BACKEND_PORT}
